{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARES production records",
  "oneOf": [
    {
      "$ref": "#/$defs/AssetManifest"
    },
    {
      "$ref": "#/$defs/FeatureObservation"
    },
    {
      "$ref": "#/$defs/QualityVerdict"
    },
    {
      "$ref": "#/$defs/AgentFinding"
    },
    {
      "$ref": "#/$defs/ReleaseDecision"
    },
    {
      "$ref": "#/$defs/ProgressEvent"
    }
  ],
  "$defs": {
    "AssetManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "asset_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        },
        "body": {
          "enum": [
            "Earth",
            "Moon",
            "Mars"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "object_key": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "observation_start": {
          "type": "string",
          "format": "date-time"
        },
        "observation_end": {
          "type": "string",
          "format": "date-time"
        },
        "format": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "coordinate_conventions": {
          "type": "string"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "adapter_version": {
          "type": "string"
        },
        "parent_asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "asset_id",
        "source_id",
        "product_id",
        "product_version",
        "body",
        "source_url",
        "object_key",
        "sha256",
        "retrieved_at",
        "observation_start",
        "observation_end",
        "format",
        "crs",
        "coordinate_conventions",
        "license_url",
        "byte_size",
        "adapter_version",
        "parent_asset_ids"
      ],
      "additionalProperties": false
    },
    "FeatureObservation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "feature_id": {
          "type": "string"
        },
        "site_id": {
          "type": "string"
        },
        "body": {
          "enum": [
            "Earth",
            "Moon",
            "Mars"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source_asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "transformation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_version": {
          "type": "string"
        },
        "support_geometry": {
          "type": "object"
        },
        "crs": {
          "type": "string"
        },
        "resolution_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "time_start": {
          "type": "string",
          "format": "date-time"
        },
        "time_end": {
          "type": "string",
          "format": "date-time"
        },
        "quality_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "unknown",
                "standard_deviation",
                "interval"
              ]
            },
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            },
            "standard_deviation": {
              "type": [
                "number",
                "null"
              ]
            },
            "basis": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "low",
            "high",
            "standard_deviation",
            "basis"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "feature_id",
        "site_id",
        "body",
        "value",
        "unit",
        "source_asset_ids",
        "transformation_ids",
        "method_version",
        "support_geometry",
        "crs",
        "resolution_m",
        "time_start",
        "time_end",
        "quality_codes",
        "missing_reason",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "QualityVerdict": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_hash": {
          "type": "string"
        },
        "action": {
          "enum": [
            "continue",
            "repair",
            "quarantine",
            "needs_mapping"
          ]
        },
        "repair_pass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              },
              "repair_rule": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "severity",
              "evidence_ids",
              "summary",
              "repair_rule"
            ],
            "additionalProperties": false
          }
        },
        "accepted_asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quarantined_asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "snapshot_hash",
        "action",
        "repair_pass",
        "issues",
        "accepted_asset_ids",
        "quarantined_asset_ids"
      ],
      "additionalProperties": false
    },
    "AgentFinding": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "mission_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "snapshot_hash": {
          "type": "string"
        },
        "model_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "claim",
              "evidence_ids",
              "limitations"
            ],
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              },
              "repair_rule": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "code",
              "severity",
              "evidence_ids",
              "summary",
              "repair_rule"
            ],
            "additionalProperties": false
          }
        },
        "recommended_action": {
          "enum": [
            "continue",
            "redo_task",
            "redo_phase",
            "recheck",
            "uncertain",
            "block"
          ]
        },
        "target_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "mission_id",
        "task_id",
        "agent_id",
        "snapshot_hash",
        "model_route",
        "summary",
        "claims",
        "issues",
        "recommended_action",
        "target_task_ids"
      ],
      "additionalProperties": false
    },
    "ReleaseDecision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "mission_id": {
          "type": "string"
        },
        "snapshot_hash": {
          "type": "string"
        },
        "review_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "enum": [
            "release",
            "release_with_limitations",
            "recheck",
            "block"
          ]
        },
        "blocking_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "mission_id",
        "snapshot_hash",
        "review_ids",
        "action",
        "blocking_issue_ids",
        "limitations",
        "reason"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "mission_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "phase": {
          "type": "string"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "retry_wait",
            "succeeded",
            "failed",
            "cancelled",
            "quarantined"
          ]
        },
        "completed_units": {
          "type": "number",
          "minimum": 0
        },
        "total_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "mission_id",
        "task_id",
        "attempt_id",
        "sequence",
        "timestamp",
        "phase",
        "state",
        "completed_units",
        "total_units",
        "summary",
        "trace_id",
        "artifact_ids"
      ],
      "additionalProperties": false
    },
    "SelectedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body",
        "coordinate_system",
        "bbox"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "enum": [
            "Earth",
            "Moon",
            "Mars"
          ]
        },
        "coordinate_system": {
          "enum": [
            "WGS84_lonlat",
            "Moon_planetocentric_east_180",
            "Mars_planetocentric_east_180"
          ]
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "kind": {
          "enum": [
            "site",
            "zone"
          ],
          "default": "site"
        }
      }
    },
    "AnalysisScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations"
      ],
      "properties": {
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "body",
              "coordinate_system",
              "bbox"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "enum": [
                  "Earth",
                  "Moon",
                  "Mars"
                ]
              },
              "coordinate_system": {
                "enum": [
                  "WGS84_lonlat",
                  "Moon_planetocentric_east_180",
                  "Mars_planetocentric_east_180"
                ]
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "kind": {
                "enum": [
                  "site",
                  "zone"
                ],
                "default": "site"
              }
            }
          },
          "minItems": 1,
          "maxItems": 3
        },
        "compare_with": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": [
              "Earth",
              "Moon",
              "Mars"
            ]
          }
        }
      },
      "description": "One selected site or zone per body. A zone contains multiple candidate/reference locations. Earth-centered comparison rules apply.",
      "allOf": [
        {
          "properties": {
            "locations": {
              "contains": {
                "properties": {
                  "body": {
                    "const": "Earth"
                  }
                },
                "required": [
                  "body"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        },
        {
          "properties": {
            "locations": {
              "contains": {
                "properties": {
                  "body": {
                    "const": "Moon"
                  }
                },
                "required": [
                  "body"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        },
        {
          "properties": {
            "locations": {
              "contains": {
                "properties": {
                  "body": {
                    "const": "Mars"
                  }
                },
                "required": [
                  "body"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        },
        {
          "if": {
            "properties": {
              "locations": {
                "contains": {
                  "properties": {
                    "body": {
                      "const": "Earth"
                    }
                  },
                  "required": [
                    "body"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "compare_with"
            ],
            "properties": {
              "compare_with": {
                "minItems": 1,
                "items": {
                  "enum": [
                    "Moon",
                    "Mars"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "compare_with": {
                "maxItems": 1,
                "items": {
                  "const": "Earth"
                }
              }
            }
          }
        }
      ]
    },
    "TargetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "location",
        "observations"
      ],
      "properties": {
        "body": {
          "enum": [
            "Moon",
            "Mars"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "body",
            "coordinate_system",
            "bbox"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "enum": [
                "Earth",
                "Moon",
                "Mars"
              ]
            },
            "coordinate_system": {
              "enum": [
                "WGS84_lonlat",
                "Moon_planetocentric_east_180",
                "Mars_planetocentric_east_180"
              ]
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "kind": {
              "enum": [
                "site",
                "zone"
              ],
              "default": "site"
            }
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "missing_sentinel": {
                "type": "number"
              },
              "missing_reason": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "unit",
              "source_id"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
