{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset_manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_version": {
      "type": "string"
    },
    "body": {
      "enum": [
        "Earth",
        "Moon",
        "Mars"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "object_key": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_start": {
      "type": "string",
      "format": "date-time"
    },
    "observation_end": {
      "type": "string",
      "format": "date-time"
    },
    "format": {
      "type": "string"
    },
    "crs": {
      "type": "string"
    },
    "coordinate_conventions": {
      "type": "string"
    },
    "license_url": {
      "type": "string",
      "format": "uri"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "adapter_version": {
      "type": "string"
    },
    "parent_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "source_id",
    "product_id",
    "product_version",
    "body",
    "source_url",
    "object_key",
    "sha256",
    "retrieved_at",
    "observation_start",
    "observation_end",
    "format",
    "crs",
    "coordinate_conventions",
    "license_url",
    "byte_size",
    "adapter_version",
    "parent_asset_ids"
  ],
  "additionalProperties": false
}
