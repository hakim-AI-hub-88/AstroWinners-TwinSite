{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release_evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qa_gate_id": {
      "type": "string",
      "minLength": 1
    },
    "qa_gate_version": {
      "type": "string",
      "minLength": 1
    },
    "data_status": {
      "enum": [
        "synthetic",
        "measured"
      ]
    },
    "strict_gate_status": {
      "enum": [
        "PASS",
        "BLOCK",
        "NOT_EVALUATED"
      ]
    },
    "release_action": {
      "enum": [
        "RELEASE",
        "QUALIFIED_RELEASE",
        "BLOCK"
      ]
    },
    "weights_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "required_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "asset_manifest.schema.json"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "evidence_observation.schema.json"
      }
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "site_id",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "input_sha256",
    "source_snapshot_id",
    "source_snapshot_sha256",
    "qa_gate_id",
    "qa_gate_version",
    "data_status",
    "strict_gate_status",
    "release_action",
    "weights_version",
    "evidence_coverage",
    "required_evidence_ids",
    "assets",
    "observations",
    "rejected_candidates",
    "assumptions",
    "unknowns",
    "blocking_issues",
    "review_ids"
  ],
  "additionalProperties": false
}
