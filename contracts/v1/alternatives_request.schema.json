{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "alternatives_request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "exclude_portfolios": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1,
        "maxItems": 3
      },
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "source_snapshot_id",
    "exclude_portfolios"
  ],
  "additionalProperties": false
}
