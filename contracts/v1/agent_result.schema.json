{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinsite.local/schemas/agent_result.schema.json",
  "title": "TwinSite AgentResult v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^A(0[1-9]|1[0-3])$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P(00|10|20|30|40|50|60|70|80|90)$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "skipped",
        "failed",
        "needs_review"
      ]
    },
    "summary": {
      "type": "string"
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "additionalProperties": true
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "enum": [
          "continue",
          "targeted_recheck",
          "repair_allowed",
          "quarantine",
          "release_qualified",
          "block"
        ]
      }
    },
    "ai_used": {
      "type": "boolean"
    },
    "method_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "run_id",
    "agent_id",
    "phase_id",
    "task_id",
    "status",
    "summary",
    "input_artifact_ids",
    "output_artifact_ids",
    "evidence_ids",
    "issues",
    "proposed_actions",
    "ai_used",
    "method_version",
    "created_at"
  ]
}