{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mission_status",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "acquiring",
        "decoding",
        "cleaning",
        "validating",
        "characterizing",
        "analyzing",
        "optimizing",
        "reviewing",
        "publishing",
        "completed",
        "completed_with_limits",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "id",
    "status",
    "attempt",
    "input_sha256",
    "source_snapshot_id",
    "error"
  ],
  "additionalProperties": false
}
