# TwinSite environment. Names only; never commit real values. Copy to .env (git-ignored).
# Every key is OPTIONAL: the platform runs with zero keys (AI features then report "not configured").

# --- AI providers (free tiers only; any number of accounts: GROQ_API_KEY, GROQ_API_KEY_2, ...) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
# Production: keep keys in a root-owned 0600 file outside the repo and point to it:
# TWINSITE_AI_SECRET_ENV_FILE=/etc/twinsite/ai-providers.env
TWINSITE_AI_ENABLED=true

# --- NASA Earthdata (optional, for authenticated acquisitions) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# --- Runtime ---
APP_HOST=127.0.0.1
APP_PORT=5050
TWINSITE_API_URL=http://127.0.0.1:8080
TWINSITE_API_HOST=127.0.0.1
TWINSITE_API_PORT=8080
TWINSITE_DATA_DIR=
# Bundled datasets (default: repo data_ready/)
DATA_READY_DIR=
TWINSITE_UPLOADS_ENABLED=false
TWINSITE_CORS_ORIGINS=
