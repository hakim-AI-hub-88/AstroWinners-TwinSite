# Public TLS server block for an APPROVED hostname only. Replace origin.example.org everywhere
# (this is the TWINSITE_VM_HOST that vercel.json proxies to).
# Certificates: e.g. `certbot certonly --webroot -w /var/www/letsencrypt -d origin.example.org`
# (or the host's managed TLS). Keep the loopback block in nginx.conf for local health checks.
server {
    listen 80;
    listen [::]:80;
    server_name origin.example.org;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name origin.example.org;
    ssl_certificate /etc/letsencrypt/live/origin.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/origin.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:twinsite_tls:10m;
    # HSTS is sent by nginx-headers.conf / nginx-console-headers.conf (ignored by browsers over plain HTTP).
    include /srv/twinsite/app/ops/vm/nginx-common.conf;
}
