# /etc/twinsite/env — site-wide settings for twinsite-web, twinsite-api and twinsite-worker.
# Install:  install -m 0600 -o root -g root ops/vm/env.example /etc/twinsite/env   (install.sh does this once)
# NAMES ONLY in the repository. Never commit values. systemd reads this file as root (EnvironmentFile=),
# and entries here override the Environment= defaults in the units. Leave a line commented to keep the default.

# --- Web (Flask via gunicorn, 127.0.0.1:5050) -------------------------------------------------
# APP_HOST=127.0.0.1
# change together with ExecStart --bind and nginx-common.conf
# APP_PORT=5050
# never 1 in production
# APP_DEBUG=0
# how Flask reaches the platform API (/v1 proxy, Auto Mode, Data Hub)
# TWINSITE_API_URL=http://127.0.0.1:8080
# TWINSITE_CONSOLE_DIST=/srv/twinsite/app/frontend/dist

# --- Bundled datasets (committed data_ready/, ~260 MB) ----------------------------------------
# DATA_READY_DIR=/srv/twinsite/app/data_ready
# default: $DATA_READY_DIR/harmonized
# HARMONIZED_DATA_DIR=
# EARTH_PROCESSED_FILE=
# MERZOUGA_PROCESSED_FILE=

# --- Platform API + worker (127.0.0.1:8080) ---------------------------------------------------
# TWINSITE_API_HOST=127.0.0.1
# TWINSITE_API_PORT=8080
# SQLite queue/results, blobs, reports, auto/ mission state
# TWINSITE_DATA_DIR=/var/lib/twinsite
# TWINSITE_SOURCE_DATA_DIR=/var/lib/twinsite/source-cache
# TWINSITE_QUEUE_LIMIT=20
# TWINSITE_LEASE_SECONDS=30
# TWINSITE_UPLOADS_ENABLED=false
# custom CA bundle for outbound HTTPS to NASA services, if needed
# TWINSITE_CA_BUNDLE=
# Browser origins allowed to call /v1 directly (comma list). Same-origin through nginx/Vercel needs none.
# TWINSITE_CORS_ORIGINS=https://twinsite.example.org

# --- AI (free-tier providers only; every key optional) ----------------------------------------
# Preferred: keep provider keys in a separate file owned by the twinsite user, mode 0600:
#   install -m 0600 -o twinsite -g twinsite /dev/null /etc/twinsite/ai-providers.env
# TWINSITE_AI_SECRET_ENV_FILE=/etc/twinsite/ai-providers.env
# TWINSITE_AI_ENABLED=true
# TWINSITE_AI_DISABLED=false
# Provider key names (put them in the AI secret file above; any number of accounts: GROQ_API_KEY_2, ...):
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=

# --- NASA Earthdata: NOT for these services ---------------------------------------------------
# The services run without Earthdata credentials (measured runs read only the verified source cache).
# EARTHDATA_TOKEN / EARTHDATA_USERNAME / EARTHDATA_PASSWORD belong to an operator account only
# (scripts/integration/provision_earthdata.py). Do not set them here.
# TWINSITE_SECRET_ENV_FILE=/etc/twinsite/services-have-no-secrets
