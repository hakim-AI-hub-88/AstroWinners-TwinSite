[Unit]
Description=TwinSite worker (deterministic science + free-only AI agents)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10
[Service]
Type=simple
User=twinsite
Group=twinsite
WorkingDirectory=/opt/twinsite
Environment=PYTHONPATH=/opt/twinsite/backend:/opt/twinsite
Environment=TWINSITE_DATA_DIR=/var/lib/twinsite
Environment=TWINSITE_SOURCE_DATA_DIR=/var/lib/twinsite/source-cache
Environment=TWINSITE_AI_ENABLED=true
# Free-only AI provider credentials: root-provisioned, owned by twinsite, mode 0600, outside the source tree.
# Missing file => AI-Powered Analysis reports unavailable and Simple Analysis runs (never paid inference).
Environment=TWINSITE_AI_SECRET_ENV_FILE=/etc/twinsite/ai-providers.env
Environment=TWINSITE_UPLOADS_ENABLED=false
# Services never hold Earthdata credentials: measured runs read only the verified cache.
# Point the optional secret file at a path that does not exist so a stray /opt/twinsite/.env is never read.
Environment=TWINSITE_SECRET_ENV_FILE=/etc/twinsite/services-have-no-secrets
ExecStart=/opt/twinsite/.venv/bin/python -m twinsite.jobs
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/twinsite
# Optional non-secret overrides (e.g. TWINSITE_CORS_ORIGINS); never put tokens here.
EnvironmentFile=-/etc/twinsite/twinsite.env
# The worker needs no network for measured runs; uncomment to enforce once acquisition runs elsewhere.
# IPAddressDeny=any
[Install]
WantedBy=multi-user.target
